        {"name": "id_mercado", "dataType": "int64"},
        {"name": "cod_mpio", "dataType": "string"},
        {"name": "cod_variedad", "dataType": "string"},
        {"name": "variedad_comercial", "dataType": "string"},
        {"name": "volumen_ingreso_ton", "dataType": "double"},
        {"name": "indice_estacional_oferta_ieo", "dataType": "double"},
        {"name": "consumo_mayorista_per_capita_kg", "dataType": "double"}
      ]
    },
    {
      "name": "Fact_Precios_SIPSA",
