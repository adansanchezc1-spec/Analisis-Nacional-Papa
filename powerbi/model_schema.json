        {"name": "cod_variedad", "dataType": "string", "isKey": true},
        {"name": "nombre_variedad", "dataType": "string"},
        {"name": "variedad_canonica", "dataType": "string"},
        {"name": "nombre_cientifico", "dataType": "string"},
        {"name": "ciclo_fenologico_dias", "dataType": "int64"},
