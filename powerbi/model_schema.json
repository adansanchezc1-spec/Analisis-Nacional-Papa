        {"name": "cod_mpio", "dataType": "string"},
        {"name": "cod_variedad", "dataType": "string"},
        {"name": "area_sembrada_ha", "dataType": "double"},
        {"name": "area_cosechada_ha", "dataType": "double"},
        {"name": "produccion_ton", "dataType": "double"},
        {"name": "rendimiento_ton_ha", "dataType": "double"},
        {"name": "tasa_perdida_cosecha_pct", "dataType": "double"},
