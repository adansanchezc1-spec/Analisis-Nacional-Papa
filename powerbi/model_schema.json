        {"name": "precio_min_kg", "dataType": "double"},
        {"name": "precio_max_kg", "dataType": "double"},
        {"name": "spread_precios_kg", "dataType": "double"},
        {"name": "num_transacciones", "dataType": "int64"},
        {"name": "indice_estacional_precio_iep", "dataType": "double"}
      ]
    }
  ],
