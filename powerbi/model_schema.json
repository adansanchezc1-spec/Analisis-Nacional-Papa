        {"name": "id_tiempo", "dataType": "int64", "isKey": true},
        {"name": "fecha", "dataType": "dateTime", "formatString": "yyyy-MM-dd"},
        {"name": "año", "dataType": "int64"},
        {"name": "mes", "dataType": "int64"},
        {"name": "nombre_mes", "dataType": "string"},
        {"name": "mes_corto", "dataType": "string"},
        {"name": "año_mes", "dataType": "string", "sortByColumn": "orden_año_mes"},
        {"name": "trimestre", "dataType": "string"},
        {"name": "año_trimestre", "dataType": "string"},
        {"name": "semestre", "dataType": "string"},
        {"name": "año_semestre", "dataType": "string"},
        {"name": "periodo_agricola", "dataType": "string"},
        {"name": "orden_año_mes", "dataType": "int64", "isHidden": true}
      ]
    },
    {
      "name": "Dim_Geografia",
      "description": "Dimensión espacial conformada a nivel de código municipal DIVIPOLA (DANE).",
