        {"name": "cod_mpio", "dataType": "string", "isKey": true},
        {"name": "municipio", "dataType": "string"},
        {"name": "cod_depto", "dataType": "string"},
        {"name": "departamento", "dataType": "string"},
        {"name": "region_natural", "dataType": "string"},
        {"name": "es_productor_destacado", "dataType": "boolean"}
      ]
    },
    {
      "name": "Dim_Variedad",
