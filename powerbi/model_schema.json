{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/semantic-model/definition/model/1.0.0/schema.json",
  "name": "Modelo_Analitico_Mercado_Papa_Colombia",
  "compatibilityLevel": 1550,
  "description": "Modelo Dimensional en Estrella (Kimball) para la caracterización integral de la oferta (EVA), demanda mayorista (SIPSA) y precios de la papa en Colombia (2019-2025).",
